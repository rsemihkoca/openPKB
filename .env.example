# Anthropic — boş bırakırsan `claude` komutu OAuth ile bağlanır (Max abonelik)
# Veya API key yapıştır (pay-per-token):
ANTHROPIC_API_KEY=

# Crawl4AI — web scraping & arama (self-hosted, ücretsiz)
# `docker compose up -d` ile başlat, http://localhost:11235 üzerinden çalışır
CRAWL4AI_URL=http://localhost:11235
# Opsiyonel: API token koruması istiyorsan boş bırakma
CRAWL4AI_API_TOKEN=

# BrowserAct — Twitter/TikTok scraping (opsiyonel)
# https://browseract.com
BROWSERACT_API_KEY=

# InfraNodus — graph gap analizi (opsiyonel)
# https://infranodus.com
INFRANODUS_API_KEY=

# Hermes Telegram bağlantısı (sonra eklersen)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
